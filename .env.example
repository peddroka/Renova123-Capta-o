NODE_ENV=development
WEB_PORT=5173
API_PORT=3333
LOCAL_API_PORT=3333
API_HOST=127.0.0.1
LOCAL_API_URL=http://127.0.0.1:3333
APP_URL=http://127.0.0.1:5173
# Local development only; production must be an HTTPS AWS API origin.
VITE_API_URL=
APP_TIMEZONE=America/Sao_Paulo
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info

# Supabase local/real. Nunca commit valores reais.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_DATABASE_URL=postgresql://postgres:password@127.0.0.1:54322/postgres

# Providers
GROQ_API_KEY=replace-with-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
TRANSCRIBE_AUDIO_ENABLED=false
OPENAI_API_KEY=replace-with-openai-key
WOLF_AI_MODEL=gpt-5.6-luna
WOLF_REASONING_EFFORT=medium
WOLF_TRANSCRIPTION_MODEL=gpt-live-transcribe
WOLF_TRANSCRIPTION_DELAY=low
WOLF_TRANSCRIPTION_PROVIDER=local
WOLF_LOCAL_TRANSCRIPTION_URL=http://127.0.0.1:8765
WOLF_LOCAL_TRANSCRIPTION_MODEL=small
WOLF_LOCAL_TRANSCRIPTION_LANGUAGE=pt
WOLF_LOCAL_TRANSCRIPTION_BEAM_SIZE=1
WOLF_LOCAL_TRANSCRIPTION_CPU_THREADS=0
WOLF_LOCAL_TRANSCRIPTION_ROLLING_WINDOW_SECONDS=5.0
WOLF_LOCAL_TRANSCRIPTION_PARTIAL_INTERVAL_SECONDS=0.45
WOLF_AUDIO_DEBUG=false
WOLF_AI_PROVIDER=ollama
WOLF_OLLAMA_BASE_URL=http://127.0.0.1:11434
WOLF_OLLAMA_MODEL=qwen3.5:9b
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY_1=replace-with-openrouter-key

# Local mode defaults
MOCK_MODE=true
MOCK_GROQ=true
MOCK_GEMINI=true
MOCK_EVOLUTION=true
MOCK_DB_PATH=.runtime/mock-db.json
SIMULATION_MODE=true
OUTREACH_ENABLED=false
OUTREACH_ONLINE_ONLY=false
OUTREACH_ONLINE_TEST_PHONE=
OUTREACH_ONLINE_TEST_PHONE=
OUTREACH_ONLINE_FRESHNESS_SECONDS=120
OUTREACH_PRESENCE_PROBE_ATTEMPTS=3
OUTREACH_PRESENCE_PROBE_INTERVAL_SECONDS=30
REAL_SENDING_ENABLED=false

# Evolution
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=replace-with-evolution-key
EVOLUTION_INSTANCE_NAME=renova123
EVOLUTION_WEBHOOK_URL=http://127.0.0.1:3333/webhooks/evolution
EVOLUTION_WEBHOOK_SECRET=replace-with-webhook-secret
WEBHOOK_SECRET=replace-with-webhook-secret

# Application
QUALIFICATION_DEADLINE_HOURS=24
WHATSAPP_QUALIFIED_GROUP_ID=
WHATSAPP_STALLED_GROUP_ID=
ENCRYPTION_KEY=replace-with-32-byte-local-key
