{
  "name": "renova123-captacao",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx scripts/dev-manager.mjs start dev",
    "wolf:dev": "tsx scripts/dev-manager.mjs start wolf",
    "dev:full": "tsx scripts/dev-manager.mjs start full",
    "dev:worker": "pnpm --filter @renova123/worker dev",
    "dev:status": "tsx scripts/dev-manager.mjs status",
    "dev:stop": "tsx scripts/dev-manager.mjs stop",
    "dev:restart": "tsx scripts/dev-manager.mjs restart",
    "francisco:start": "tsx scripts/dev-manager.mjs start francisco",
    "francisco:status": "tsx scripts/dev-manager.mjs status francisco",
    "francisco:stop": "tsx scripts/dev-manager.mjs stop francisco",
    "francisco:restart": "tsx scripts/dev-manager.mjs restart francisco",
    "francisco:preflight": "tsx scripts/francisco-preflight.ts",
    "wolf:status": "tsx scripts/dev-manager.mjs status",
    "wolf:stop": "tsx scripts/dev-manager.mjs stop",
    "wolf:restart": "tsx scripts/dev-manager.mjs restart wolf",
    "support:bundle": "tsx scripts/support-bundle.mjs",
    "wolf:transcription": "tsx scripts/run-wolf-transcription.ts",
    "wolf:check": "tsx scripts/wolf-check.ts",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa:francisco": "tsx scripts/qa-francisco.ts",
    "test:reset-francisco": "tsx scripts/run-controlled-francisco-opener.ts --reset-only 5582988543864",
    "test:francisco": "tsx scripts/run-controlled-francisco-opener.ts --start 5582988543864",
    "wolf:extension:build": "pnpm --filter @renova123/wolf-extension build",
    "wolf:extension:typecheck": "pnpm --filter @renova123/wolf-extension typecheck",
    "setup": "powershell -ExecutionPolicy Bypass -File ./setup.ps1",
    "doctor": "powershell -ExecutionPolicy Bypass -File ./doctor.ps1",
    "db:validate": "node scripts/validate-migrations.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.1.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
