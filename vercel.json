{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "wolf-transcription": {
      "root": "services/wolf-transcription"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "wolf-transcription"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
