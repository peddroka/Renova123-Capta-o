{
  "name": "@renova123/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "pnpm --filter @renova123/shared build && pnpm --filter @renova123/core build && pnpm --filter @renova123/database build && pnpm --filter @renova123/integrations build && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@renova123/core": "workspace:*",
    "@renova123/database": "workspace:*",
    "@renova123/integrations": "workspace:*",
    "@renova123/shared": "workspace:*",
    "@supabase/supabase-js": "^2.53.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "pino-pretty": "^13.1.1",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
