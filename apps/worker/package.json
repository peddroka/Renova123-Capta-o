{
  "name": "@renova123/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --conditions=development src/supervisor.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/supervisor.js",
    "start:child": "node dist/index.js",
    "supervisor": "tsx --conditions=development src/supervisor.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@renova123/core": "workspace:*",
    "@renova123/database": "workspace:*",
    "@renova123/integrations": "workspace:*",
    "@renova123/shared": "workspace:*",
    "@supabase/supabase-js": "^2.53.0",
    "dotenv": "^17.2.1",
    "pino": "^9.7.0",
    "zod": "^3.25.76"
  }
}
