[Unit]
Description=Renova123 Captação Worker Supervisor
After=network-online.target evolution-api.service postgresql.service redis-server.service renova123-api.service
Wants=network-online.target evolution-api.service renova123-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Renova123-Capta-o
Environment=NODE_ENV=production
EnvironmentFile=-/home/ubuntu/Renova123-Capta-o/.env
ExecStart=/usr/bin/pnpm --filter @renova123/worker start
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
KillSignal=SIGTERM
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
